{
  "name": "subbi-backend",
  "version": "2.0.0",
  "private": true,
  "description": "Backend kont i synchronizacji subskrypcji dla aplikacji subbi (NestJS + Prisma + Swagger)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "prisma migrate deploy && nest start --watch",
    "build": "nest build",
    "start:prod": "prisma migrate deploy && node dist/main.js",
    "db:migrate": "prisma migrate deploy",
    "db:new-migration": "prisma migrate dev --name",
    "typecheck": "tsc --noEmit -p test/tsconfig.json",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "@nestjs/jwt": "12.0.4",
    "@nestjs/platform-express": "12.4.0",
    "@nestjs/swagger": "12.1.1",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.2.3",
    "express": "5.3.0",
    "prisma": "7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.12",
    "@nestjs/schematics": "12.0.13",
    "@nestjs/testing": "12.4.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "7.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  },
  "overrides": {
    "effect": "3.22.4"
  }
}
